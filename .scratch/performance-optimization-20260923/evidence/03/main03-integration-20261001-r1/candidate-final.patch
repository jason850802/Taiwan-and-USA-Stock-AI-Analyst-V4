+const creationMs = value => {
+  const text = String(value ?? '');
+  const legacy = /^\/Date\((-?\d+)(?:[+-]\d{4})?\)\/$/.exec(text);
+  return legacy ? Number(legacy[1]) : Date.parse(text);
+};
