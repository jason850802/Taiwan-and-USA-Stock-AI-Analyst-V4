+function spawnLogged(name, argv, env, runId) {
+  const logFile = path.join(runtimeDir, `${name}-${runId}.log`);
+  const fd = fs.openSync(logFile, 'a');
+  const child = spawn(process.execPath, argv, {
+    cwd: root,
+    env,
+    stdio: ['ignore', fd, fd],
+    windowsHide: true,
+  });
