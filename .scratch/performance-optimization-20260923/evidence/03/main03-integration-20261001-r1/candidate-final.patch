+export function sameOutcome(b1, c) {
+  if (b1.status !== c.status) return false;
+  if (b1.lines?.length || c.lines?.length) return JSON.stringify((b1.lines ?? []).map(line => line.text)) === JSON.stringify((c.lines ?? []).map(line => line.text));
