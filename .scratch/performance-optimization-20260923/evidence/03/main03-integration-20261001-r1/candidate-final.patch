+];
+const STEP_BY_ID = new Map(STEPS.map(step => [step.id, step]));
+
+// 隔離 checkout 的 git：safe.directory 只經環境變數給這一個目錄，不改任何 git 設定檔。
+const git = (cwd, args) => execFileSync('git', args, {
+  cwd,
