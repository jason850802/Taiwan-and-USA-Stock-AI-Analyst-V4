+      preloadToDevServerMs: onPath(span(boot, listen1)),
+      devServerToHandlerLoadedMs: onPath(span(listen1, listen2)),
+      handlerLoadedToReadyMs: onPath(span(listen2, ready)),
+      startupSinceTimeOriginMs: onPath(ready ? ready.t : null),
